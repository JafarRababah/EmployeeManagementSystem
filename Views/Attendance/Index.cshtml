@model IEnumerable<EmployeesManagment.Models.Attendance>

@{
    ViewData["Title"] = "”Ã·«  «·Õ÷Ê— Ê«·«‰’—«›";
}

<h2 class="mb-4 text-center">Attendance List</h2>

<div class="d-flex justify-content-between mb-3">
    <a asp-action="Import" class="btn btn-primary">
        <i class="fa fa-plus"></i> Add New Attendance
    </a>

    <form asp-action="Index" method="get" class="form-inline">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Emp Search..." />
        <button type="submit" class="btn btn-secondary ml-2">
            <i class="fa fa-search"></i> Search
        </button>
    </form>
</div>

<table class="table table-bordered table-striped">
    <thead class="thead-dark text-center">
        <tr>
            <th>Employee</th>
            <th>The Date</th>
            <th>Check In</th>
            <th>Check Out</th>
            <th>Total Hours</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Employee?.FullName</td>
                    <td>@item.Date.ToString("yyyy-MM-dd")</td>
                    <td>@item.CheckIn?.ToString("HH:mm")</td>
                    <td>@item.CheckOut?.ToString("HH:mm")</td>
                    <td>@item.TotalHours</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                            <i class="fa fa-pencil"></i> Edit
                        </a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                            <i class="fa fa-eye"></i> View
                        </a>
                        <a asp-action="Create" asp-route-id="@item.Id" class="btn btn-sm btn-success">
                            <i class="fa fa-import"></i> Create
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                            <i class="fa fa-trash"></i> Delete
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted">No Attendance Now</td>
            </tr>
        }
    </tbody>
</table>

@model EmployeesManagment.ViewModels.EmployeeViewModel

@{
    ViewData["Title"] = "Employees List";
}



<div class="card">
    <div class="card-header">
        <div class="mb-3 float-end">
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-file-plus-fill"></i> Add New Employee</a>
        </div>
    </div>
    <div class="card-body">
        <div class="col-md-12">
            <div class="row">
                <form asp-action="Index" enctype="multipart/form-data" class="form-vertical">
                    <div class="row">
                        <div class="form-group col-md-4">
                            <label asp-for="EmpNo" class="control-label"></label>
                            <input asp-for="EmpNo" name="EmpNo" class="form-control" />
                        </div>
                        <div class="form-group col-md-4">
                            <label asp-for="FullName" class="control-label"></label>
                            <input asp-for="FullName" name="FullName" class="form-control" />
                        </div>
                        <div class="form-group col-md-4">
                            <label asp-for="PhoneNumber" class="control-label"></label>
                            <input asp-for="PhoneNumber" name="PhoneNumber" class="form-control" />
                        </div>
                        <div class="col-md-2 mt-20">
                        <button type="submit" class="btn btn-success btn-block mt-20"><i class="fa fa-search"></i>Search</button>
                    </div>
                    <div class="col-md-2 mt-20">
                        <button type="reset" class="btn btn-default btn-block mt-20"><i class="fa fa-eraser"></i>Clear</button>
                    </div>
            </div>
                </form>
            </div>
        </div>
    </div>
</div>
<div class="card-body" id="employeesTableWrapper">
    @await Html.PartialAsync("_EmployeesTable", Model)
</div>
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {

            // أي تغيير أو كتابة في الحقول يشغّل البحث مباشرة
            $('input[name="EmpNo"], input[name="FullName"], input[name="PhoneNumber"]').on('input', function () {
                performSearch();
            });

            // البحث باستخدام Ajax
            function performSearch() {
                var empNo = $('input[name="EmpNo"]').val();
                var fullName = $('input[name="FullName"]').val();
                var phoneNumber = $('input[name="PhoneNumber"]').val();

                $.ajax({
                    url: '@Url.Action("FilterEmployees", "Employees")',
                    type: 'GET',
                    data: {
                        EmpNo: empNo,
                        FullName: fullName,
                        PhoneNumber: phoneNumber
                    },
                    success: function (result) {
                        // تحديث الجدول بالنتيجة الجديدة
                        $('#employeesTableWrapper').html(result);
                    },
                    error: function () {
                        alert("حدث خطأ أثناء تحميل البيانات.");
                    }
                });
            }
        });
    </script>
}





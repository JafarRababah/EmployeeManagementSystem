@model EmployeesManagment.ViewModels.Reports.EmployeeReportFilterVM
@{
    ViewData["Title"] = "Reports";
}

<h2 class="mb-4">Reports</h2>

<div class="container">

    <!-- Employees Reports Card -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Employees Reports</h4>
        </div>
        <div class="card-body">
            <form id="employeesFilters" class="mb-3">
                <div class="row g-2">
                    <div class="col-md-4">
                        <input type="text" class="form-control" id="empName"
                               name="fullName" value="@Model.FullName"
                               placeholder="Search by name">
                    </div>
                    <div class="col-md-4">
                        <select id="empDept" name="departmentId" asp-for="DepartmentId"
                                class="form-control" asp-items="Model.Departments">
                            <option value="">Search by department</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button type="button" class="btn btn-secondary w-100"
                                onclick="applyEmployeeFilters()">
                            Apply Filters
                        </button>
                    </div>
                </div>
            </form>

            <div class="d-flex gap-2">
                <a class="btn btn-success" id="downloadEmpExcel" href="#" onclick="downloadEmployees('excel')">Download Excel</a>
                <a class="btn btn-danger" id="downloadEmpPdf" href="#" onclick="downloadEmployees('pdf')">Download PDF</a>
            </div>

            <!-- جدول عرض الموظفين -->
            <div class="mt-4">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Emp No</th>
                            <th>Name</th>
                            <th>Department</th>
                            <th>Email</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Employees != null && Model.Employees.Any())
                        {
                            foreach (var emp in Model.Employees)
                            {
                                <tr>
                                    <td>@emp.EmpNo</td>
                                    <td>@emp.FullName</td>
                                    <td>@emp.Department?.Name</td>
                                    <td>@emp.EmailAddress</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center">No employees found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function applyEmployeeFilters() {
            const name = document.getElementById('empName').value.trim();
            const deptId = document.getElementById('empDept').value;
            let url = '/Reports/Employees';
            const params = [];
            if (name) params.push(`fullName=${encodeURIComponent(name)}`);
            if (deptId) params.push(`departmentId=${deptId}`);
            if (params.length > 0) {
                url += '?' + params.join('&');
            }
            window.location.href = url;
        }

        function downloadEmployees(format) {
            const name = document.getElementById('empName').value.trim();
            const deptId = document.getElementById('empDept').value;
            let url = `/Reports/Employees${format === 'excel' ? 'Excel' : 'Pdf'}`;
            const params = [];
            if (name) params.push(`fullName=${encodeURIComponent(name)}`);
            if (deptId) params.push(`departmentId=${deptId}`);
            if (params.length > 0) {
                url += '?' + params.join('&');
            }
            window.location.href = url;
        }
    </script>
}

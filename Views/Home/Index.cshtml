@model EmployeesManagment.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Employees";
}


<!-- Small boxes (Stat box) -->
<div class="row">
    <!-- Pending Leaves -->
    <div class="col-lg-3 col-6">
        <div class="small-box bg-info">
            <div class="inner">
                <h3>@(Model.PendingLeaves)</h3>
                <p>New Leave Applications</p>
            </div>
            <div class="icon"><i class="ion ion-bag"></i></div>
            <a asp-action="Index" asp-controller="LeaveApplications" class="small-box-footer">More <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>

    <!-- New Employees -->
    <div class="col-lg-3 col-6">
        <div class="small-box bg-success">
            <div class="inner">
                <h3>@(Model.NewEmployees)</h3>
                <p>New Employees This Month</p>
            </div>
            <div class="icon"><i class="ion ion-person-add"></i></div>
            <a asp-action="Index" asp-controller="Employees" class="small-box-footer">More <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>

    <!-- Late Rate -->
    <div class="col-lg-3 col-6">
        <div class="small-box bg-warning">
            <div class="inner">
                <h3>@(Model.LateRate)<sup style="font-size: 20px">%</sup></h3>
                <p>Late Rate</p>
            </div>
            <div class="icon"><i class="ion ion-stats-bars"></i></div>
            <a asp-action="Index" asp-controller="Attendance" class="small-box-footer">More <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>

    <!-- Total Salary -->
    <div class="col-lg-3 col-6">
        <div class="small-box bg-danger">
            <div class="inner">
                <h3>@(Model.TotalSalary)</h3>
                <p>Total Salary</p>
            </div>
            <div class="icon"><i class="ion ion-cash"></i></div>
            <a asp-action="Index" asp-controller="Salaries" class="small-box-footer">More <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
</div>
<!-- /.row -->
<!-- Main row -->

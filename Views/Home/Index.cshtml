    <!-- right col -->
</div>
<!-- /.row (main row) -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const months = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Months));
    const attendanceData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AttendanceData));
    const leaveData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeaveData));

    // ====== مخطط الأعمدة ======
    new Chart(document.getElementById("attendanceChart"), {
        type: "bar",
        data: {
            labels: months,
            datasets: [
                {
                    label: "Attendance",
                    data: attendanceData,
                    backgroundColor: "rgba(54, 162, 235, 0.7)",
                    borderRadius: 6
                },
                {
                    label: "Leaves",
                    data: leaveData,
                    backgroundColor: "rgba(255, 99, 132, 0.7)",
                    borderRadius: 6
                }
            ]
        },
        options: {
            responsive: true,
            scales: {
                y: { beginAtZero: true }
            },
            plugins: {
                legend: { display: true, position: "bottom" }
            }
        }
    });

    // ====== مخطط دونات ======
    new Chart(document.getElementById("leaveChart"), {
        type: "doughnut",
        data: {
            labels: ["Annual", "Sick", "Unpaid", "Other"],
            datasets: [{
                data: [35, 25, 20, 20],
                backgroundColor: [
                    "rgba(75, 192, 192, 0.8)",
                    "rgba(255, 205, 86, 0.8)",
                    "rgba(255, 99, 132, 0.8)",
                    "rgba(201, 203, 207, 0.8)"
                ]
            }]
        },
        options: {
            plugins: { legend: { position: "bottom" } }
        }
    });
</script>

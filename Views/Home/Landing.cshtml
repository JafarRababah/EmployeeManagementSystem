<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- ضع هذا داخل بطاقة Basic (استبدل YOUR_SANDBOX_CLIENT_ID) -->
    <!-- تحميل SDK مرة واحدة فقط في الصفحة -->
    <script src="https://www.paypal.com/sdk/js?client-id=ASPyAslWa8ATUY5FnONjn3nKQ0ydDHBmxwV8p4cQvXa7vWNRe_nDSOPIT_pvL1bHKakEUE9KHmdjaGMp&currency=USD"></script>


    <script>
        // تأكد أن SDK محمّل
        window.addEventListener('DOMContentLoaded', function() {
          if (!window.paypal) {
            console.error('PayPal SDK not loaded');
            return;
          }

          paypal.Buttons({
            style: { layout: 'vertical', color: 'gold', shape: 'rect', label: 'paypal' },

            createOrder: function(data, actions) {
              // استدعي السيرفر لإنشاء Order (server-side create)
              return fetch('/paypal/create-order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ amount: '29.00', currency: 'USD' })
              })
              .then(res => {
                if (!res.ok) throw new Error('Create order failed');
                return res.json();
              })
              .then(json => {
                // يجب أن يعيد السيرفر { orderID: "..." }
                if (!json || !json.orderID) throw new Error('Invalid response from server');
                return json.orderID;
              });
            },

            onApprove: function(data, actions) {
              // بعد موافقة المستخدم نطلب من السيرفر التقاط الدفع (capture)
              return fetch('/paypal/capture-order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ orderID: data.orderID })
              })
              .then(res => {
                if (!res.ok) throw new Error('Capture failed');
                return res.json();
              })
              .then(details => {
                // تعامل مع النتيجة: حفظ في DB، إظهار صفحة نجاح، إلخ
                console.log('Capture details:', details);
                // مثال: تحويل لصفحة نجاح مع رقم الطلب
                window.location.href = '/payment/success?orderId=' + encodeURIComponent(data.orderID);
              })
              .catch(err => {
                console.error(err);
                alert('Payment failed. Check console for details.');
              });
            },

            onError: function(err) {
              console.error('PayPal error', err);
              alert('An error occurred during PayPal checkout.');
            }
          }).render('#paypal-button-container-basic');
        });
    </script>
<script>
  document.getElementById('year').innerText = new Date().getFullYear();

  // Toggle dark mode
  document.getElementById('toggleTheme').addEventListener('click', () => {
    document.body.classList.toggle('dark-mode');
  });

  // Example: fetch dashboard KPIs (adjust endpoint to your API)
  async function loadKpis(){
    try{
      const res = await fetch('/Dashboard/Index');
      if(!res.ok) return;
      const data = await res.json();
      document.getElementById('stat-attendance').innerText = data.attendancesToday || 0;
      document.getElementById('stat-late').innerText = data.lateEmployees || 0;
      document.getElementById('stat-leaves').innerText = data.activeLeaves || 0;
      document.getElementById('stat-hours').innerText = data.monthlyAverageHours || 0;

      const ctx = document.getElementById('kpiChart').getContext('2d');
      new Chart(ctx, {
        type: 'bar',
        data: {
          labels: ['Attendance','Late','Leaves','Avg Hours'],
          datasets: [{label: 'KPIs', data: [data.attendancesToday, data.lateEmployees, data.activeLeaves, data.monthlyAverageHours]}]
        }
      });
    }catch(e){console.error(e)}
  }
  loadKpis();
</script>

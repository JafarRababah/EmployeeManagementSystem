@model EmployeesManagment.Models.Payroll

@{
    ViewData["Title"] = "Payrolls";
}

<div class="row">
    <div class="col-md-12 mx-auto">
        <div class="card border-top border-0 border-4 border-info">
            <div class="card-body">
                <div class="border p-4 rouded">
                    <div class="card-title d-flex align-items-counter">
                        <div>
                            <i class="bx bxs-user me-1 font-22 text-info"></i>
                        </div>
                        <h5 class="mb-0 text-info"> Add Payroll</h5> 
                    </div><br />
                    <div class="col-md-12">
                        <form asp-action="Create">
                            <div class="row g-3">
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                <div class="form-group col-md-6">
                                    <label asp-for="EmployeeId" class="control-label"></label>
                                    @Html.DropDownListFor(
                                    m => m.EmployeeId,
                                                                        (SelectList)ViewData["EmployeeId"],
                                                                        "-- Select Employee --",
                                                                        new { @class = "form-control" }
                                                                        )

                                    <span asp-validation-for="EmployeeId" class="text-danger"></span>
                                </div>

                                @if (ViewBag.EmployeeName != null)
                                {
                                    <p>Selected Employee: @ViewBag.EmployeeName</p>
                                }


                                <div class="form-group form-check col-md-6">
                                    <input asp-for="IsFullAttendance" class="form-check-input" type="checkbox" id="IsFullAttendance" />
                                    <label asp-for="IsFullAttendance" class="form-check-label" for="IsFullAttendance">
                                        Full Attendance
                                    </label>
                                </div>
                                <div class="form-group col-md-6">
                                    <label asp-for="PeriodStart" class="control-label"></label>
                                    <input asp-for="PeriodStart"  type="date" class="form-control" />
                                    <span asp-validation-for="PeriodStart" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-6">
                                    <label asp-for="PeriodEnd" class="control-label"></label>
                                    <input asp-for="PeriodEnd"  type="date" class="form-control" />
                                    <span asp-validation-for="PeriodEnd" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-6">
                                    <label asp-for="BasicSalary" class="control-label"></label>
                                    <input asp-for="BasicSalary" id="basicSalary" class="form-control" readonly />
                                    <span asp-validation-for="BasicSalary" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-6">
                                    <label asp-for="Allowances" class="control-label"></label>
                                    <input asp-for="Allowances" id="allowances" class="form-control" readonly />
                                    <span asp-validation-for="Allowances" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-6">
                                    <label asp-for="Overtime" class="control-label"></label>
                                    <input asp-for="Overtime" id="overtime" class="form-control" />
                                    <span asp-validation-for="Overtime" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-6">
                                    <label asp-for="Deductions" class="control-label"></label>
                                    <input asp-for="Deductions" id="deductions" class="form-control" readonly />
                                    <span asp-validation-for="Deductions" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-6">
                                    <label asp-for="Tax" class="control-label"></label>
                                    <input asp-for="Tax" class="form-control" id="tax" />
                                    <span asp-validation-for="Tax" class="text-danger"></span>
                                </div>

                                <div class="form-group col-md-6">
                                    <label asp-for="SocialSecurity" class="control-label"></label>
                                    <input asp-for="SocialSecurity" class="form-control" id="socialSecurity" />
                                    <span asp-validation-for="SocialSecurity" class="text-danger"></span>
                                </div>

                                <div class="form-group col-md-6">
                                    <label asp-for="Bonus" class="control-label"></label>
                                    <input asp-for="Bonus" class="form-control" id="bonus" />
                                    <span asp-validation-for="Bonus" class="text-danger"></span>
                                </div>

                                <div class="form-group col-md-6">
                                    <label asp-for="Penalty" class="control-label"></label>
                                    <input asp-for="Penalty" class="form-control" id="penalty" />
                                    <span asp-validation-for="Penalty" class="text-danger"></span>
                                </div>

                                <div class="form-group col-md-6">
                                    <label asp-for="NetSalary" class="control-label"></label>
                                    <input asp-for="NetSalary" disabled id="netSalary" class="form-control" />
                                    <span asp-validation-for="NetSalary" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <a asp-action="Index" class="btn btn-warning float-start">Back to List</a>
                                    <input type="submit" value="Register Payroll" class="btn btn-primary float-end" />
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#EmployeeId").change(function () {
                var empId = $(this).val();
                if (empId) {
                    $.getJSON('/Payrolls/GetSalaryByEmployeeId', { employeeId: empId }, function (data) {
                        if (data) {
                            $("#basicSalary").val(data.basicSalary);
                            $("#allowances").val(data.allowance);
                            $("#deductions").val(data.deductions);
                            $("#netSalary").val(data.netSalary);
                        } else {
                            $("#BasicSalary, #Allowance, #Deductions, #NetSalary").val('');
                        }
                    });
                } else {
                    $("#BasicSalary, #Allowance, #Deductions, #NetSalary").val('');
                }
            });
        });
    </script>

    <script>
        function calculateNetSalary() {
            let basic = parseFloat(document.getElementById("basicSalary").value) || 0;
            let allowances = parseFloat(document.getElementById("allowances").value) || 0;
            let overtime = parseFloat(document.getElementById("overtime").value) || 0;
            let deductions = parseFloat(document.getElementById("deductions").value) || 0;
                let tax = parseFloat(document.getElementById("tax").value) || 0;
        let social = parseFloat(document.getElementById("socialSecurity").value) || 0;
        let bonus = parseFloat(document.getElementById("bonus").value) || 0;
        let penalty = parseFloat(document.getElementById("penalty").value) || 0;
            let net = (basic + allowances + overtime+bonus) - deductions-tax-social-penalty;
            document.getElementById("netSalary").value = net.toFixed(2);
        }

        // ÔÛá ÇáÍÓÇÈ ÚäÏ ÇáÊÛííÑ Ýí Ãí ÍÞá
        document.querySelectorAll("#basicSalary, #allowances, #overtime, #deductions, #tax, #socialSecurity, #bonus, #penalty")
            .forEach(input => input.addEventListener("input", calculateNetSalary));
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

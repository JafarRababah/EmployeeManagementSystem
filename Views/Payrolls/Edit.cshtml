@model EmployeesManagment.Models.Payroll

@{
    ViewData["Title"] = "Update Payrolls";
}

<div class="row">
    <div class="col-md-12 mx-auto">
        <div class="card border-top border-0 border-4 border-info">
            <div class="card-body">
                <div class="border p-4 rouded">
                    <div class="card-title d-flex align-items-counter">
                        <div>
                            <i class="bx bxs-user me-1 font-22 text-info"></i>
                        </div>
                        <h5 class="mb-0 text-info"> Update Payroll</h5>
                    </div><br />
                    <div class="col-md-12">
                        <form asp-action="Edit">
                            <div class="row g-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="PayrollId" />
            <input type="hidden" asp-for="CreatedById" />
            <input type="hidden" asp-for="CreatedOn" />
                                <div class="form-group col-md-6">
                <label asp-for="EmployeeId" class="control-label"></label>
                <select asp-for="EmployeeId" class="form-control" asp-items="ViewBag.EmployeeId"></select>
                <span asp-validation-for="EmployeeId" class="text-danger"></span>
            </div>
                                <div class="form-group col-md-6">
                <label asp-for="PeriodStart" class="control-label"></label>
                <input asp-for="PeriodStart" disabled class="form-control" />
                <span asp-validation-for="PeriodStart" class="text-danger"></span>
            </div>
                                <div class="form-group col-md-6">
                <label asp-for="PeriodEnd" class="control-label"></label>
                <input asp-for="PeriodEnd" disabled class="form-control" />
                <span asp-validation-for="PeriodEnd" class="text-danger"></span>
            </div>
                                <div class="form-group col-md-6">
                <label asp-for="BasicSalary" class="control-label"></label>
                                    <input asp-for="BasicSalary" id="basicSalary" class="form-control" />
                <span asp-validation-for="BasicSalary" class="text-danger"></span>
            </div>
                                <div class="form-group col-md-6">
                <label asp-for="Allowances" class="control-label"></label>
                                    <input asp-for="Allowances" id="allowances" class="form-control" />
                <span asp-validation-for="Allowances" class="text-danger"></span>
            </div>
                                <div class="form-group col-md-6">
                <label asp-for="Overtime" class="control-label"></label>
                                    <input asp-for="Overtime" id="overtime" class="form-control" />
                <span asp-validation-for="Overtime" class="text-danger"></span>
            </div>
                                <div class="form-group col-md-6">
                <label asp-for="Deductions" class="control-label"></label>
                                    <input asp-for="Deductions" id="deductions" class="form-control" />
                <span asp-validation-for="Deductions" class="text-danger"></span>
            </div>
                                <div class="form-group col-md-6">
                <label asp-for="NetSalary" class="control-label"></label>
                                    <input asp-for="NetSalary" id="netSalary" class="form-control" />
                <span asp-validation-for="NetSalary" class="text-danger"></span>
            </div>
         
            </div>
                            <div class="form-group">
                                <a asp-action="Index" class="btn btn-warning float-start"><i class="bi bi-skip-backward-fill"></i> Back to List</a>
                                <button type="submit" class="btn btn-primary float-end"><i class="bi bi-floppy-fill"></i> Save</button>
                            </div>
        </form>
    </div>
</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function calculateNetSalary() {
            let basic = parseFloat(document.getElementById("basicSalary").value) || 0;
            let allowances = parseFloat(document.getElementById("allowances").value) || 0;
            let overtime = parseFloat(document.getElementById("overtime").value) || 0;
            let deductions = parseFloat(document.getElementById("deductions").value) || 0;

            let net = basic + allowances + overtime - deductions;
            document.getElementById("netSalary").value = net.toFixed(2);
        }

        // ÔÛá ÇáÍÓÇÈ ÚäÏ ÇáÊÛííÑ Ýí Ãí ÍÞá
        document.querySelectorAll("#basicSalary, #allowances, #overtime, #deductions")
            .forEach(input => input.addEventListener("input", calculateNetSalary));
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

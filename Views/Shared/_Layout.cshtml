    <!-- SignalR -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.11/signalr.min.js"></script>

    <!-- Notifications & Custom Scripts -->
    <script>
        if (!window.connection) {
            window.connection = new signalR.HubConnectionBuilder()
                .withUrl("/notificationHub")
                .build();

            // إشعار جديد (غير مقروء)
             window.connection.on("ReceiveNotification", function (n) {

            const countEl = document.getElementById('unread-count');
            const unreadList = document.getElementById('unread-list');

            countEl.textContent = parseInt(countEl.textContent || '0') + 1;

            unreadList.querySelector('.text-muted')?.parentElement.remove();

            const li = document.createElement('li');
            li.innerHTML = `
                <a class="dropdown-item fw-bold"
                   href="${n.url ?? '#'}"
                   onclick="markAsRead(${n.id})">
                    ${n.message}
                </a>`;
            unreadList.prepend(li);
        });


            window.connection.start()
                .catch(err => console.error(err.toString()));
        }

        // تحميل الإشعارات (غير المقروء + الكل)
        async function loadNotifications() {
            const res = await fetch('/Notifications/GetUserNotifications');
            const data = await res.json();

            const unreadCountEl = document.getElementById('unread-count');
            const unreadList = document.getElementById('unread-list');
            const allList = document.getElementById('all-list');

            unreadCountEl.textContent = data.unreadCount;

            unreadList.innerHTML = '';
            allList.innerHTML = '';

            if (!data.notifications.length) {
                unreadList.innerHTML = '<li><span class="dropdown-item text-muted">لا توجد إشعارات جديدة</span></li>';
                allList.innerHTML = '<li><span class="dropdown-item text-muted">لا توجد إشعارات</span></li>';
                return;
            }

            data.notifications.forEach(n => {

                // كل الإشعارات
                allList.innerHTML += `
                    <li>
                        <a class="dropdown-item ${n.isRead ? '' : 'fw-bold'}"
                           href="${n.url ?? '#'}"
                           onclick="markAsRead(${n.id})">
                            ${n.message}
                            <small class="text-muted d-block">${n.createdOn}</small>
                        </a>
                    </li>`;

                // غير المقروء
                if (!n.isRead) {
                    unreadList.innerHTML += `
                        <li>
                            <a class="dropdown-item fw-bold"
                               href="${n.url ?? '#'}"
                               onclick="markAsRead(${n.id})">
                                ${n.message}
                            </a>
                        </li>`;
                }
            });
        }

        function markAsRead(id) {
            fetch(`/Notifications/MarkAsRead/${id}`, { method: 'POST' })
                .then(() => loadNotifications());
        }

        loadNotifications();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>








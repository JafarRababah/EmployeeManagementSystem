    <script src="/AdminLTE/plugins/jszip/jszip.min.js"></script>
    <script src="/AdminLTE/plugins/pdfmake/pdfmake.min.js"></script>
    <script src="/AdminLTE/plugins/pdfmake/vfs_fonts.js"></script>
    <script src="/AdminLTE/plugins/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="/AdminLTE/plugins/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="/AdminLTE/plugins/datatables-buttons/js/buttons.colVis.min.js"></script>

    <!-- JQVMap -->
    <script src="/AdminLTE/plugins/jqvmap/jquery.vmap.min.js"></script>
    <script src="/AdminLTE/plugins/jqvmap/maps/jquery.vmap.usa.js"></script>

    <!-- SignalR -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.11/signalr.min.js"></script>

    <!-- Notifications & Custom Scripts -->
    <script>
        // Notifications SignalR
        if (!window.connection) {
            window.connection = new signalR.HubConnectionBuilder()
                .withUrl("/notificationHub")
                .build();

            window.connection.on("ReceiveNotification", function(message, url) {
                const countEl = document.getElementById('notification-count');
                const listEl = document.getElementById('notification-list');
                let count = parseInt(countEl.textContent || '0') + 1;
                countEl.textContent = count;

                const li = document.createElement('li');
                li.innerHTML = `<a class="dropdown-item" href="${url ?? '#'}">${message}</a>`;
                listEl.prepend(li);
            });

            window.connection.start().catch(err => console.error(err.toString()));
        }

        async function loadNotifications() {
            const res = await fetch('/Notifications/GetUserNotifications');
            const data = await res.json();
            const countEl = document.getElementById('notification-count');
            const listEl = document.getElementById('notification-list');
            countEl.textContent = data.unreadCount;
            listEl.innerHTML = '';

            if (!data.notifications.length) {
                listEl.innerHTML = '<li><a class="dropdown-item text-muted">لا توجد إشعارات</a></li>';
                return;
            }

            data.notifications.forEach(n => {
                const li = document.createElement('li');
                li.innerHTML = `<a class="dropdown-item" href="${n.url ?? '#'}">${n.Message} <small class="text-muted">${n.CreatedOn}</small></a>`;
                listEl.appendChild(li);
            });
        }
        loadNotifications();

        // DataTables Initialization
        $(function () {
            $("#example1").DataTable({
                "responsive": true,
                "lengthChange": false,
                "autoWidth": false,
                "buttons": ["copy","csv","excel","pdf","print","colvis"]
            }).buttons().container().appendTo('#example1_wrapper .col-md-6:eq(0)');
        });

        // JQVMap Initialization
        $(function() {
            $('#world-map').vectorMap({
                map: 'usa_en',
                backgroundColor: null,
                regionStyle: { initial: { fill: '#c4c4c4' } }
            });
        });
    </script>


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>







